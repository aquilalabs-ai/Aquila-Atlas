# Git hosting tokens (optional — needed for private repos or git tool API access)
GITHUB_TOKEN=           # GitHub PAT — 'repo' scope for private repos
GITLAB_TOKEN=           # GitLab PAT — read_api + read_repository scope
GITEA_TOKEN=            # Gitea/Forgejo access token

# LLM provider — choose one: openai | ollama | openai_compatible | anthropic | mistral | huggingface
LLM_PROVIDER=ollama

# LLM model and credentials
# Ollama (default):   LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2
# OpenAI:             LLM_PROVIDER=openai   LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o
# Anthropic:          LLM_PROVIDER=anthropic LLM_API_KEY=sk-ant-... LLM_MODEL=claude-sonnet-4-6
# Mistral:            LLM_PROVIDER=mistral   LLM_API_KEY=...  LLM_MODEL=mistral-large-latest
# HuggingFace:        LLM_PROVIDER=huggingface LLM_API_KEY=hf_... LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# OpenAI-compatible:  LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://api.groq.com/openai/v1 ...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Embeddings — OpenAI-compatible endpoint (can differ from LLM endpoint)
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant (local)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Qdrant Cloud (set these to use Qdrant Cloud instead of local; leave blank for local)
QDRANT_URL=
QDRANT_API_KEY=

# PostgreSQL (session store)
POSTGRES_URL=postgresql://aquila:aquila@localhost:5432/aquila

# Valkey/Redis (job store — persists ingestion jobs across restarts and workers)
VALKEY_URL=redis://localhost:6379/0

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                        # leave blank for open/dev mode (no auth)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Authentication & licensing — set AUTH_MODE=disabled to preserve the original open behaviour
# AUTH_MODE: disabled (default) | key | ldap | both
AUTH_MODE=disabled

# Instance license JWT — RS256-signed by vendor (required when AUTH_MODE != disabled)
AQUILA_LICENSE_KEY=

# HS256 secret for signing session tokens — generate with: openssl rand -hex 32
AQUILA_JWT_SECRET=dev-secret-change-me-in-production

# RSA public key used to verify license and seat key signatures.
# Required when AUTH_MODE != disabled.
# Generate a key pair with: python scripts/generate_keypair.py
# Encode the PEM on a single line by replacing every newline with \n, then wrap in double quotes:
#   AQUILA_VENDOR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----"
# On Linux/macOS: awk 'NF{printf "%s\\n",$0} END{print ""}' vendor_public_key.pem
# On Windows (PowerShell): (Get-Content vendor_public_key.pem -Raw).TrimEnd("`n").Replace("`n","\n")
AQUILA_VENDOR_PUBLIC_KEY=

# Number of inactive days before a seat is considered idle and reclaimed (default: 30)
SEAT_IDLE_DAYS=30

# LDAP / Active Directory — only required when AUTH_MODE=ldap or both
LDAP_URL=ldap://dc.company.com:389
LDAP_BIND_DN=CN=svc-aquila,OU=ServiceAccounts,DC=company,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=OU=Users,DC=company,DC=com
LDAP_USER_FILTER=(mail={username})
LDAP_REQUIRED_GROUP=            # optional — restrict login to members of this AD group

# LangSmith tracing (optional — leave LANGSMITH_API_KEY blank to disable)
# Sign up at https://smith.langchain.com to get an API key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
