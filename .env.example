# GitHub (optional — only needed for GitHub source loader)
# For private repositories, the token must have 'repo' scope
GITHUB_TOKEN=

# LLM — OpenAI-compatible endpoint
# Ollama (default):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
# OpenAI:            LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
# Any other OpenAI-compatible provider follows the same pattern
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Embeddings — OpenAI-compatible endpoint (can differ from LLM endpoint)
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# PostgreSQL (session store)
POSTGRES_URL=postgresql://aquila:aquila@localhost:5432/aquila

# Valkey/Redis (job store — persists ingestion jobs across restarts and workers)
VALKEY_URL=redis://localhost:6379/0

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                        # leave blank for open/dev mode (no auth)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LangSmith tracing (optional — leave LANGSMITH_API_KEY blank to disable)
# Sign up at https://smith.langchain.com to get an API key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
