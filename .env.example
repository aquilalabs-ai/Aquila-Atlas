# GitHub (optional — only needed for GitHub source loader)
GITHUB_TOKEN=

# LLM — OpenAI-compatible endpoint
# Ollama (default):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
# OpenAI:            LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
# Any other OpenAI-compatible provider follows the same pattern
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Embeddings — OpenAI-compatible endpoint (can differ from LLM endpoint)
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Valkey (Redis-compatible)
VALKEY_URL=valkey://localhost:6379
